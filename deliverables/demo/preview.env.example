# Copy to .runtime/private/preview.env on the server and chmod 600.
# Never commit the copied file or real values.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER_USERNAME=demo-issuer
AUTH_ISSUER_PASSWORD=replace-with-a-strong-password
AUTH_REVIEWER_USERNAME=demo-reviewer
AUTH_REVIEWER_PASSWORD=replace-with-a-strong-password
AUTH_STUDENT_USERNAME=demo-student
AUTH_STUDENT_PASSWORD=replace-with-a-strong-password
AUTH_STUDENT_SUBJECT_HASH=e21b5e0c1a136d1c910aea031527936cb024a4ea95ea1a236b5383056d466926
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
AUTH_TTL_SECONDS=3600
AUTH_SECURE_COOKIE=false
AUTH_ALLOW_NON_BROWSER_CLIENTS=false
# The preview launcher generates an Ed25519 pair in .runtime/private on first start.
# Set these optional file paths only when using an existing private key pair.
# VC_ISSUER_PRIVATE_KEY_FILE=/absolute/private/path/vc-issuer-private.pem
# VC_ISSUER_PUBLIC_KEY_FILE=/absolute/private/path/vc-issuer-public.pem
VC_PUBLIC_BASE_URL=http://127.0.0.1:3000
